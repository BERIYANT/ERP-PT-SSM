<aside class="project-sidebar"><div class="project-switcher"><span>▣</span><span title="{{ project.name }}">{{ project.project_code }}<br><small>{{ project.name }}</small></span><a href="{% url 'erp:project-list' %}" title="Ganti proyek">⌄</a></div><nav class="project-nav"><span>WORKBOOK PROYEK</span><a class="{% if active_project_nav == 'dashboard' %}active{% endif %}" href="{% url 'erp:project-dashboard' project.id %}">01 Project Control</a><a href="{% url 'erp:project-dashboard' project.id %}?sheet=po-rab">02 PO &amp; RAB</a><a class="{% if active_project_nav == 'services' %}active{% endif %}" href="{% url 'erp:project-services' project.id %}">03 RAB Jasa</a><a class="{% if active_project_nav == 'materials' %}active{% endif %}" href="{% url 'erp:project-materials' project.id %}">04 RAB Material</a><a class="{% if active_project_nav == 'overhead' %}active{% endif %}" href="{% url 'erp:project-overhead' project.id %}">05 Progress Mandor</a><a class="{% if active_project_nav == 'foreman_advances' %}active{% endif %}" href="{% url 'erp:project-foreman-advances' project.id %}">06 Pengajuan Dana</a><a href="{% url 'erp:project-dashboard' project.id %}?sheet=actual-cost">07 Expense / Lap Keu</a><a href="{% url 'erp:project-dashboard' project.id %}?sheet=invoice">08 Invoice &amp; Cash In</a></nav></aside>