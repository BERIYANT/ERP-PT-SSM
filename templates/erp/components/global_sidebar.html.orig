<aside class="global-sidebar"><div class="brand"><span class="brand-mark">S</span><div class="brand-copy">SSM ERP<small>PROJECT CONTROL</small></div></div><div class="nav-label">Menu Utama</div><nav class="global-nav">{% for key,label,url_name in global_navigation %}<a href="{% url url_name %}" class="{% if active_global_nav == key %}active{% endif %}">{{ label }}</a>{% endfor %}</nav><div class="sidebar-user"><div class="nav-label sidebar-user__label">Pengguna</div><strong>{{ request.user.nama|default:request.user.username }}</strong><br><small>{{ request.user.role|upper }}</small><br><br><a href="{% url 'erp:profile' %}">Pengaturan profil →</a></div></aside>