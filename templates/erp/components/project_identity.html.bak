<div class="project-identity"><div><div class="eyebrow">Project Workspace</div><h2>{{ project.name }}</h2><small>{{ project.project_code }} · {{ project.client.name }}</small></div><div style="text-align:right"><span class="badge {{ project.status }}">{{ project.status }}</span><br><small>{{ project.start_date|default:'Tanggal mulai belum diisi' }} – {{ project.end_date|default:'Berjalan' }}</small></div></div>