{% extends 'erp/layouts/app.html' %}{% block page_content %}<div class="page-head"><div><div class="eyebrow">Financial Workbook</div><h2>Cash Flow Project</h2><p>Ledger otomatis dari pencairan dana, expense, invoice, dan pembayaran.</p></div></div><div class="cards"><div class="card"><span>Total Cash In</span><strong>Rp {{ cash_in|floatformat:0 }}</strong><small>penerimaan terposting</small></div><div class="card"><span>Total Cash Out</span><strong>Rp {{ cash_out|floatformat:0 }}</strong><small>pengeluaran terposting</small></div><div class="card"><span>Ending Balance</span><strong>Rp {{ balance|floatformat:0 }}</strong><small>saldo aktual ledger</small></div></div><nav class="workbook-strip" style="margin-top:13px" aria-label="Cash flow"><a class="workbook-tab {% if cash_tab == 'all' %}active{% endif %}" href="?tab=all">Cash Flow</a><a class="workbook-tab {% if cash_tab == 'in' %}active{% endif %}" href="?tab=in">Cash In</a><a class="workbook-tab {% if cash_tab == 'out' %}active{% endif %}" href="?tab=out">Cash Out</a><a class="workbook-tab {% if cash_tab == 'project' %}active{% endif %}" href="?tab=project">By Project</a></nav><div class="sheet"><div class="table-wrap">{% if cash_tab == 'project' %}<table><thead><tr><th class="row-index">No</th><th>Kode Project</th><th>Nama Project</th><th class="numeric">Cash In</th><th class="numeric">Cash Out</th></tr></thead><tbody>{% for item in project_summary %}<tr><td class="row-index">{{ forloop.counter }}</td><td><strong>{{ item.project__project_code }}</strong></td><td>{{ item.project__name }}</td><td class="numeric">Rp {{ item.cash_in|default:0|floatformat:0 }}</td><td class="numeric">Rp {{ item.cash_out|default:0|floatformat:0 }}</td></tr>{% empty %}<tr><td colspan="5" class="empty">Belum ada transaksi per proyek.</td></tr>{% endfor %}</tbody></table>{% else %}<table><thead><tr><th class="row-index">No</th><th>Tanggal</th><th>Kode Project</th><th>Referensi Sumber</th><th>Kategori</th><th class="numeric">Cash In</th><th class="numeric">Cash Out</th></tr></thead><tbody>{% for item in transactions %}<tr><td class="row-index">{{ forloop.counter }}</td><td>{{ item.transaction_date }}</td><td><strong>{{ item.project.project_code }}</strong><br><small>{{ item.project.name }}</small></td><td>{{ item.reference_number }}</td><td>{{ item.category }}</td><td class="numeric">{% if item.direction == 'IN' %}Rp {{ item.amount|floatformat:0 }}{% else %}-{% endif %}</td><td class="numeric">{% if item.direction == 'OUT' %}Rp {{ item.amount|floatformat:0 }}{% else %}-{% endif %}</td></tr>{% empty %}<tr><td colspan="7" class="empty">Belum ada transaksi kas yang sudah diposting.</td></tr>{% endfor %}<tr class="total-row"><td colspan="5">TOTAL / SALDO AKHIR</td><td class="numeric">Rp {{ cash_in|floatformat:0 }}</td><td class="numeric">Rp {{ cash_out|floatformat:0 }}<br><small>Saldo Rp {{ balance|floatformat:0 }}</small></td></tr></tbody></table>{% endif %}</div></div>{% endblock %}