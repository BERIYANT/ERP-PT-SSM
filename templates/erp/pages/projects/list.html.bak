{% extends 'erp/layouts/app.html' %}{% block page_content %}<div class="page-head"><div><div class="eyebrow">Master Data</div><h2>Daftar Proyek</h2><p>Pusat hubungan PO, RAB, pekerjaan lapangan, dan keuangan.</p></div><a class="btn" href="{% url 'erp:project-create' %}">+ Proyek Baru</a></div><nav class="workbook-strip" aria-label="Data proyek"><a class="workbook-tab {% if project_tab == 'register' %}active{% endif %}" href="?tab=register">Project Register</a><a class="workbook-tab {% if project_tab == 'segments' %}active{% endif %}" href="?tab=segments">Segment</a><a class="workbook-tab {% if project_tab == 'members' %}active{% endif %}" href="?tab=members">Project Member</a></nav><div class="sheet"><div class="table-wrap">{% if project_tab == 'register' %}<table><thead><tr><th class="row-index">No</th><th>Kode</th><th>Nama Proyek</th><th>Customer</th><th>Mulai</th><th>Selesai</th><th>Status</th><th class="col-aksi">Aksi</th></tr></thead><tbody>{% for item in projects %}<tr><td class="row-index">{{ forloop.counter }}</td><td><strong>{{ item.project_code }}</strong></td><td class="description">{{ item.name }}</td><td>{{ item.client.name }}</td><td>{{ item.start_date|default:'-' }}</td><td>{{ item.end_date|default:'-' }}</td><td><span class="badge {{ item.status }}">{{ item.status }}</span></td><td><div class="inline-actions"><a class="btn secondary compact" href="{% url 'erp:project-dashboard' item.id %}">Workspace</a><a class="btn secondary compact" href="{% url 'erp:project-edit' item.id %}">Edit</a><form method="post" action="{% url 'erp:project-deactivate' item.id %}" onsubmit="return confirm('Nonaktifkan proyek ini?')">{% csrf_token %}<button class="btn secondary compact">Nonaktifkan</button></form></div></td></tr>{% empty %}<tr><td colspan="8" class="empty">Belum ada proyek.</td></tr>{% endfor %}</tbody></table>{% elif project_tab == 'segments' %}<table><thead><tr><th class="row-index">No</th><th>Project</th><th>Kode Segment</th><th>Nama Segment</th><th>Lokasi</th><th>Status</th></tr></thead><tbody>{% for item in segments %}<tr><td class="row-index">{{ forloop.counter }}</td><td><strong>{{ item.project.project_code }}</strong><br><small>{{ item.project.name }}</small></td><td>{{ item.segment_code }}</td><td>{{ item.segment_name }}</td><td>{{ item.location|default:'-' }}</td><td>{% if item.is_active %}<span class="badge APPROVED">AKTIF</span>{% else %}<span class="badge CLOSED">NONAKTIF</span>{% endif %}</td></tr>{% empty %}<tr><td colspan="6" class="empty">Belum ada segment proyek.</td></tr>{% endfor %}</tbody></table>{% else %}<table><thead><tr><th class="row-index">No</th><th>Project</th><th>Nama Pegawai</th><th>Segment</th><th>Peran</th><th>Mulai Bertugas</th><th>Status</th></tr></thead><tbody>{% for item in project_members %}<tr><td class="row-index">{{ forloop.counter }}</td><td><strong>{{ item.project.project_code }}</strong><br><small>{{ item.project.name }}</small></td><td>{{ item.employee.name }}</td><td>{{ item.segment.segment_name|default:'Semua Segment' }}</td><td>{{ item.get_assignment_role_display }}</td><td>{{ item.assigned_at }}</td><td>{% if item.is_active %}<span class="badge APPROVED">AKTIF</span>{% else %}<span class="badge CLOSED">NONAKTIF</span>{% endif %}</td></tr>{% empty %}<tr><td colspan="7" class="empty">Belum ada anggota proyek.</td></tr>{% endfor %}</tbody></table>{% endif %}</div></div>{% endblock %}