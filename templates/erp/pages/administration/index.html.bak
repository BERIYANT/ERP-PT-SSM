{% extends 'erp/layouts/app.html' %}{% block page_content %}<div class="page-head"><div><div class="eyebrow">System Administration</div><h2>Organisasi & Akun</h2><p>Data pegawai, akun, dan role dalam satu struktur perusahaan.</p></div></div><div class="cards"><div class="card"><span>Perusahaan</span><strong>{{ company.name|default:'-' }}</strong></div><div class="card"><span>Pegawai</span><strong>{{ employees|length }}</strong></div><div class="card"><span>Akun Terhubung</span><strong>{{ accounts|length }}</strong></div><div class="card"><span>Role Sistem</span><strong>{{ roles|length }}</strong></div></div><div class="workbook-strip" style="margin-top:13px"><span class="workbook-tab active">User Organization</span><span class="workbook-tab">Employee</span><span class="workbook-tab">Role</span></div><div class="sheet"><div class="table-wrap"><table><thead><tr><th class="row-index">No</th><th>Username</th><th>Nama Pegawai</th><th>Nomor Pegawai</th><th>Role</th><th>Status</th></tr></thead><tbody>{% for item in accounts %}<tr><td class="row-index">{{ forloop.counter }}</td><td><strong>{{ item.user.username }}</strong></td><td>{{ item.employee.name|default:item.user.nama }}</td><td>{{ item.employee.employee_no|default:'-' }}</td><td>{{ item.role.name }}</td><td><span class="badge APPROVED">AKTIF</span></td></tr>{% empty %}<tr><td colspan="6" class="empty">Belum ada akun organisasi.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}